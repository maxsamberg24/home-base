// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(cuid())
  name                String
  friendCode          String?   @unique
  venmoHandle         String?
  lockerNote          String? // whiteboard: max ~30 words, enforced in the action
  lockerNoteUpdatedAt DateTime?
  createdAt           DateTime  @default(now())

  favoriteTeams     FavoriteTeam[]
  notes             TeamNote[]
  memberships       GroupMember[]
  seasonPredictions SeasonPrediction[]
  awardPredictions  AwardPrediction[]
  linePicks         LinePick[]
  straightPicks     StraightPick[]
  survivorPicks     SurvivorPick[]
  fantasyLineups    FantasyLineup[]
  gameAttendances   GameAttendance[]
  groupPosts        GroupPost[]
  photos            Photo[]
  gameLogEntries    GameLogEntry[]
  trophies          Trophy[]
  medals            Medal[]
  friendshipsA      Friendship[]       @relation("FriendA")
  friendshipsB      Friendship[]       @relation("FriendB")
  wagersCreated     Wager[]            @relation("WagerCreator")
  wagersReceived    Wager[]            @relation("WagerOpponent")
}

// A team a user follows. league is our own slug (see src/lib/leagues.ts),
// teamId is ESPN's team id within that league. fanIntensity is chosen when
// following (or changed later from the team page): SUPERFAN teams get
// priority styling on the home feed and calendar, CASUAL ones don't.
model FavoriteTeam {
  id           String   @id @default(cuid())
  userId       String
  league       String
  teamId       String
  fanIntensity String   @default("CASUAL") // CASUAL | SUPERFAN
  addedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, league, teamId])
}

// A game a user has flagged themselves as planning to attend, from the
// "See get-in price" ticket link. Purely a personal/shared calendar marker —
// no ticketing integration.
model GameAttendance {
  id        String   @id @default(cuid())
  userId    String
  league    String
  eventId   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, league, eventId])
}

// Free-text notes a user keeps on a team (ticket info, rivalries, who to watch).
model TeamNote {
  id        String   @id @default(cuid())
  userId    String
  league    String
  teamId    String
  content   String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, league, teamId])
}

// Mutual friend connection, made by sharing a friendCode. Stored once per
// pair with userAId < userBId (enforced in application code) so the unique
// constraint catches duplicates regardless of who initiated.
model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("FriendA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
}

// Peer-to-peer wager: post a pick, a friend accepts / counters / declines.
// Settlement (who won) is recorded manually by either side once accepted —
// there's no automatic grading against ESPN results for these free-form bets.
model Wager {
  id          String   @id @default(cuid())
  creatorId   String
  opponentId  String?
  league      String?
  eventId     String?
  description String
  type        String   @default("CUSTOM") // SPREAD | MONEYLINE | PROP | CUSTOM
  line        String?
  stake       Float
  status      String   @default("OPEN") // OPEN | COUNTERED | ACCEPTED | DECLINED | SETTLED
  result      String? // CREATOR_WON | OPPONENT_WON | PUSH
  counterOfId String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator     User   @relation("WagerCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  opponent    User?  @relation("WagerOpponent", fields: [opponentId], references: [id], onDelete: SetNull)
  counterOf   Wager? @relation("WagerCounter", fields: [counterOfId], references: [id], onDelete: SetNull)
  counteredBy Wager? @relation("WagerCounter")
}

model Group {
  id          String   @id @default(cuid())
  name        String
  inviteCode  String   @unique
  createdById String
  createdAt   DateTime @default(now())

  // Survivor pool buy-in: agreed on by the group, then locked before picks
  // start so the pot (buyIn * entrant count) is fixed for the season.
  survivorBuyIn   Float?
  survivorLocked  Boolean @default(false)

  members        GroupMember[]
  linePicks      LinePick[]
  straightPicks  StraightPick[]
  survivorPicks  SurvivorPick[]
  fantasyLineups FantasyLineup[]
  posts          GroupPost[]
  medals         Medal[]
}

// A short text post on a group's board — e.g. "tickets to Rams @ Giants are
// $50 right now, anyone wanna rip it" — optionally tied to a specific game.
model GroupPost {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  message   String
  league    String?
  eventId   String?
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

// One row per user per season. winTotals is a JSON map of ESPN team id -> predicted win count.
model SeasonPrediction {
  id        String   @id @default(cuid())
  userId    String
  season    Int
  winTotals String // JSON: { "19": 11, "17": 9, ... }
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, season])
}

// category: SB_WINNER | MVP | OROY | DROY | COACH_OY
model AwardPrediction {
  id       String @id @default(cuid())
  userId   String
  season   Int
  category String
  value    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, season, category])
}

// Weekly "guess the closing spread" game, scoped to a group.
model LinePick {
  id            String   @id @default(cuid())
  groupId       String
  userId        String
  season        Int
  week          Int
  seasonType    Int      @default(2)
  eventId       String
  guessedSpread Float // home-team-perspective spread, e.g. -3.5 means home favored by 3.5
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId, eventId])
}

// Weekly straight-up (no spread) winner pick'em, scoped to a group.
model StraightPick {
  id            String   @id @default(cuid())
  groupId       String
  userId        String
  season        Int
  week          Int
  seasonType    Int      @default(2)
  eventId       String
  pickedTeamId  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId, eventId])
}

// Survivor pool: one winner pick per week, each team usable once per season, scoped to a group.
model SurvivorPick {
  id           String   @id @default(cuid())
  groupId      String
  userId       String
  season       Int
  week         Int
  seasonType   Int      @default(2)
  eventId      String
  pickedTeamId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId, season, week])
}

// Weekly best-lineup fantasy game, scoped to a group: 1 QB, 2 RB, 2 WR, 1 TE,
// 1 K, 1 DEF, resets every week. `roster` is a JSON map of slot name ->
// { id, name, teamId, teamAbbr } (id/teamId are ESPN athlete/team ids; DEF's
// "id" is just its own teamId, since it's a team unit not a player).
model FantasyLineup {
  id         String   @id @default(cuid())
  groupId    String
  userId     String
  season     Int
  week       Int
  seasonType Int      @default(2)
  roster     String
  updatedAt  DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId, season, week])
}

// --- My Locker ---

// A user-uploaded photo, stored directly in Postgres (no external blob
// storage set up) — capped at a few MB each, no resizing/compression. Up to
// three can be pinned to the public locker door (publicSlot 1-3); the rest
// sit in private storage. One can optionally be filed under a game log entry.
model Photo {
  id          String   @id @default(cuid())
  userId      String
  contentType String
  data        Bytes
  caption     String?
  publicSlot  Int? // 1, 2, or 3 — null means private storage only
  gameLogId   String?
  createdAt   DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameLog GameLogEntry? @relation(fields: [gameLogId], references: [id], onDelete: SetNull)

  @@unique([userId, publicSlot])
}

// A game a user logs having attended in person. Free-form opponent/date so
// it isn't tied to a specific ESPN event existing/matching.
model GameLogEntry {
  id        String   @id @default(cuid())
  userId    String
  league    String?
  opponent  String
  gameDate  DateTime
  note      String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos Photo[]
}

// A championship a followed team won, detected from ESPN's postseason
// schedule (see src/lib/trophies.ts) — only awarded for seasons that
// complete from here forward, never backfilled for past years.
model Trophy {
  id        String   @id @default(cuid())
  userId    String
  league    String
  teamId    String
  season    Int
  title     String // e.g. "Super Bowl Champions"
  awardedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, league, teamId, season])
}

// A medal earned by winning a group game mode for a season (or week, for the
// weekly-resetting fantasy game) — see src/lib/medals.ts. week defaults to 0
// (rather than null) for season-level medals so the unique constraint below
// actually catches duplicates — Postgres treats NULL as distinct per row,
// which would silently defeat idempotency for SURVIVOR/LINES/STRAIGHT.
model Medal {
  id        String   @id @default(cuid())
  userId    String
  groupId   String
  gameMode  String // SURVIVOR | FANTASY_WEEK | LINES | STRAIGHT
  season    Int
  week      Int      @default(0) // set only for FANTASY_WEEK; 0 = season-level
  title     String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId, gameMode, season, week])
}
